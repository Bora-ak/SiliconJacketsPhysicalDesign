#=============================================================================#
#			                       Load Flow Config																	#
#=============================================================================#
source "$::env(SCRIPTS)/config.tcl"

#=============================================================================#
#                           Innovus Initialization														#
#=============================================================================#
if {$::config::INIT} {
	sj_run_step step_init_apr
}

#=============================================================================#
#                           Floorplan																					#
#=============================================================================#
if {$::config::FLOORPLAN} {
	sj_run_step step_floorplan
}

#=============================================================================#
#                           Placement																					#
#=============================================================================#
if {$::config::PLACE} {
	sj_run_step step_place_std_cells
	sj_run_step step_place_ties
}

#=============================================================================#
#                           Clock Tree Synthesis															#
#=============================================================================#
if {$::config::CTS} {
	sj_run_step step_pre_cts_opt
	sj_run_step step_cts
	sj_run_step step_post_cts_opt
}

#=============================================================================#
#                           Routing																						#
#=============================================================================#
if {$::config::ROUTE} {
	sj_run_step step_route
	sj_run_step step_fill
}

#=============================================================================#
#                           Signoff																						#
#=============================================================================#
if {$::config::SIGNOFF} {
	sj_run_step step_physical_verify
	sj_run_step step_extract
}

# This just tells interactive mode that we've pushed all steps onto the stack
if {$::config::INTERACTIVE} {
	sj_end_collection
} else {
	exit
}
